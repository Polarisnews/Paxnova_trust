# ────────────────────────────────────────────────────────────────────────
# Paxnova Trust — production environment template
#
# Copy this file to `.env.production` on the VPS and fill the values.
# NEVER commit the filled file. `.gitignore` already excludes `.env*`.
#
# Generate the secrets locally and paste the output:
#
#   SESSION_SECRET (≥32 chars, random):
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
#   ENCRYPTION_KEY (exactly 32 bytes = 64 hex chars):
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Once set, Next.js will pick these up automatically when started with
# NODE_ENV=production.
# ────────────────────────────────────────────────────────────────────────

# Required ─────────────────────────────────────────────────────────────
NODE_ENV=production

# iron-session cookie signing secret. Generate with the command above.
# Treat like a database password — if it leaks, rotate immediately.
SESSION_SECRET=

# AES-256-GCM key for reversible card-data encryption (PAN / CVV plaintext
# columns in the `cards` table). MUST be 32 bytes = 64 hex characters.
# Rotating this key invalidates every encrypted blob; plan migration.
ENCRYPTION_KEY=

# Absolute path to the SQLite database file. Keep it on a persistent
# volume (NOT inside the application directory that gets blown away by
# git deploys). Recommended: /var/lib/paxnovatrust/paxnovatrust.db
DB_PATH=/var/lib/paxnovatrust/paxnovatrust.db

# Where uploaded KYC / business-formation documents land. Should be on
# the same persistent volume as the database, NOT inside the deploy dir.
UPLOAD_DIR=/var/lib/paxnovatrust/uploads

# Optional ─────────────────────────────────────────────────────────────

# Resend API key for real outbound email. Without this the mailer logs
# to the server console (fine for staging, useless for prod).
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Display "From" address on outbound mail.
# MAIL_FROM=Paxnova Trust <no-reply@yourdomain.com>

# Public Google Maps key for the address-autocomplete component (signup +
# contact). Loadable in the browser; leave empty to disable autocomplete.
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Port the Next.js server listens on. Caddy proxies to this port. The
# systemd unit defaults to 3000, set this only if you need to override.
# PORT=3000
