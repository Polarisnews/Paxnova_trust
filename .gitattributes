# Ensure deploy + shell scripts stay LF on Linux even when authored on
# Windows. Without this, .sh files cloned on the VPS can break with
# "/usr/bin/env: 'bash\r'" parse errors.
*.sh           text eol=lf
*.bash         text eol=lf
deploy/*       text eol=lf
.env.*         text eol=lf
*.service      text eol=lf
Caddyfile      text eol=lf
